# Required: PostgreSQL database with the pgvector extension available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required: use a unique random value (for example, `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Text generation: ollama for local development, or groq for hosted inference.
LLM_PROVIDER=ollama
GROQ_API_KEY=

# Optional account integrations. Email-based signup and recovery need Resend.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
FROM_EMAIL=

# Browser origin(s), comma-separated when using more than one.
FRONTEND_ORIGIN=http://localhost:8000

# Optional vision extraction settings.
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=llava
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=pixtral-12b-2409

# Optional when Tesseract is not available on PATH (commonly needed on Windows).
TESSERACT_CMD=
